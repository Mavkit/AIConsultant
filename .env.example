# Local Docker Compose only. Use a secret store outside local development.
EL_RAGER_DB_PASSWORD=replace-for-local-use
EL_RAGER_DB_PORT=5432
EL_RAGER_WEB_PORT=3000
EL_RAGER_API_PORT=3001

# The deterministic provider is safe for local development and CI.
AI_PROVIDER=deterministic
OPENAI_MODEL=gpt-5.6-terra
# Set only in a local secret store when AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
